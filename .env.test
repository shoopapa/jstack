# Test environment — used by the integration and e2e suites, locally and in CI.
# Every host/port belongs to the isolated stack in docker-compose.test.yml.
DATABASE_URL="postgres://postgres:postgres@localhost:25300/jstack_test?sslmode=disable"
TZ=UTC

# The port Playwright's standalone server binds; getBaseUrl() reads it too.
PORT=23000

AUTH_SECRET="ci-e2e-auth-secret-minimum-32-chars"
