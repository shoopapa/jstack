{
  "name": "@jstack/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "seed:root": "pnpm with-env tsx src/seed-root.ts",
    "create:org": "pnpm with-env tsx src/create-org.ts",
    "seed:org": "pnpm with-env tsx src/seed-org.ts"
  },
  "dependencies": {
    "@jstack/auth": "workspace:*",
    "@jstack/db": "workspace:*",
    "cmd-ts": "^0.15.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jstack/oxlint-config": "workspace:*",
    "@jstack/prettier-config": "workspace:*",
    "@jstack/tsconfig": "workspace:*",
    "dotenv-cli": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@jstack/prettier-config"
}
