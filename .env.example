# Local dev database (docker-compose.yml). Created by `pnpm --filter @jstack/db nuke`.
DATABASE_URL="postgres://postgres:postgres@localhost:5300/postgres?sslmode=disable"
TZ=UTC

# better-auth signing/encryption secret — at least 32 chars. `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-random-32-plus-char-secret"

# Public origin of the app in deployed envs, e.g. https://app.example.com.
# Unset locally: falls back to http://localhost:$PORT.
# NEXT_PUBLIC_APP_URL=
