{
  "name": "@jstack/nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev --turbopack | pnpm pino-pretty",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "oxlint --type-aware",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@jstack/api": "workspace:*",
    "@jstack/auth": "workspace:*",
    "@jstack/db": "workspace:*",
    "@jstack/logger": "workspace:*",
    "@jstack/ui": "workspace:*",
    "@jstack/validators": "workspace:*",
    "@t3-oss/env-nextjs": "catalog:t3-oss",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:better-auth",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "catalog:",
    "server-only": "^0.0.1",
    "superjson": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jstack/oxlint-config": "workspace:*",
    "@jstack/prettier-config": "workspace:*",
    "@jstack/tailwind-config": "workspace:*",
    "@jstack/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "dotenv-cli": "catalog:",
    "jiti": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "13.2.0",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@jstack/prettier-config"
}
